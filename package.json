{
  "name": "circuit-json-to-altium",
  "version": "0.0.1",
  "description": "Convert Circuit JSON schematic and PCB content into native Altium Designer project documents",
  "module": "lib/index.ts",
  "types": "lib/index.ts",
  "type": "module",
  "files": ["lib"],
  "trustedDependencies": ["altiumts"],
  "scripts": {
    "check": "bun run format:check && bun run typecheck && bun test",
    "download-references": "bun run scripts/download-references.ts",
    "format": "biome check --write .",
    "format:check": "biome check .",
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tscircuit/circuit-json-to-altium.git"
  },
  "keywords": [
    "circuit-json",
    "altium",
    "pcb",
    "schematic",
    "eda",
    "tscircuit"
  ],
  "license": "MIT",
  "dependencies": {
    "@resvg/resvg-js": "2.6.2",
    "altiumts": "github:tscircuit/altiumts#1fad5fa2b7b9f4e83b06072d5b965f153aae1c48",
    "cfb": "^1.2.2",
    "circuit-json": "^0.0.480",
    "color-string": "2.1.4",
    "jszip": "^3.10.1",
    "schematic-symbols": "^0.0.239",
    "transformation-matrix": "^3.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@types/bun": "latest",
    "bun-match-svg": "^0.0.16",
    "circuit-to-svg": "^0.0.403",
    "tscircuit": "^0.0.2352",
    "typescript": "^5.9.3"
  }
}
